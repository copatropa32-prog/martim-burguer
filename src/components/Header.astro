<header class="sticky top-0 z-40 bg-zinc-900/85 backdrop-blur-md border-b border-zinc-800">
  <div class="max-w-6xl mx-auto px-4 h-20 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <!-- Logotipo Oficial -->
      <img 
        src="/logo.jpg" 
        alt="Logotipo Martim Food" 
        class="w-12 h-12 rounded-full object-cover border border-zinc-700 shadow-lg shadow-red-600/30" 
      />
      
      <div>
        <h1 class="text-lg font-bold tracking-wide">Martim Food</h1>
        <p class="text-xs text-emerald-400 font-medium flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Aberto hoje até 23:30
        </p>
      </div>
    </div>

    <!-- Botão do Carrinho -->
    <button id="open-cart-btn" class="relative bg-zinc-800 hover:bg-zinc-700 text-zinc-200 px-4 py-2.5 rounded-xl font-medium transition flex items-center gap-2 border border-zinc-700">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
      <span>Carrinho</span>
      <span id="cart-counter" class="absolute -top-2 -right-2 bg-red-600 text-white text-xs w-6 h-6 rounded-full flex items-center justify-center font-bold shadow-md">0</span>
    </button>
  </div>
</header>